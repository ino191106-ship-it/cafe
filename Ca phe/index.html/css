:root {
  --bg:#F6F4EE;
  --card:#fff;
  --ink:#14261E;
  --mute:#62736B;
  --green:#17402F;
  --green2:#245C45;
  --amber:#E8A33D;
  --line:#E2E6E1;
  --err:#B3261E;
  --sh:0 8px 24px rgba(20,38,30,.08);
}

* {
  box-sizing:border-box;
  margin:0;
}

html {
  scroll-behavior:smooth;
}

body {
  font-family:'Be Vietnam Pro',system-ui,sans-serif;
  background:var(--bg);
  color:var(--ink);
  line-height:1.6;
}

button,input,select {
  font:inherit;
  color:inherit;
}

button {
  cursor:pointer;
}

:focus-visible {
  outline:3px solid var(--amber);
  outline-offset:2px;
}

.wrap {
  max-width:1120px;
  margin:0 auto;
  padding:0 20px;
}

section {
  scroll-margin-top:80px;
}

.topbar {
  background:#0D2A1F;
  color:#BFD6CB;
  font-size:13px;
}

.topbar .wrap {
  display:flex;
  justify-content:space-between;
  gap:12px;
  padding-top:6px;
  padding-bottom:6px;
  flex-wrap:wrap;
}

header {
  background:rgba(23,64,47,.96);
  backdrop-filter:blur(8px);
  color:#fff;
  position:sticky;
  top:0;
  z-index:20;
}

header .wrap {
  display:flex;
  align-items:center;
  justify-content:space-between;
  height:64px;
}

.logo {
  display:flex;
  align-items:center;
  gap:8px;
  font-weight:800;
  font-size:20px;
  background:none;
  border:0;
  color:#fff;
}

nav {
  display:flex;
  gap:26px;
}

nav button {
  background:none;
  border:0;
  color:#D6E6DE;
  font-weight:500;
  padding:4px 0;
  border-bottom:2px solid transparent;
}

nav button:hover {
  color:#fff;
  border-color:var(--amber);
}

.cart-btn {
  background:var(--amber);
  color:var(--ink);
  border:0;
  border-radius:999px;
  padding:8px 18px;
  font-weight:700;
  transition:transform .15s;
}

.cart-btn:hover {
  transform:translateY(-1px);
}

.hero {
  background:radial-gradient(circle at 80% 20%,#2D7455 0,#17402F 55%);
  color:#fff;
  overflow:hidden;
}

.hero .wrap {
  display:grid;
  grid-template-columns:1.1fr 1fr;
  gap:40px;
  align-items:center;
  padding-top:56px;
}

.eyebrow {
  display:inline-block;
  background:rgba(232,163,61,.18);
  color:#F5C878;
  border-radius:999px;
  padding:4px 14px;
  font-size:13px;
  font-weight:700;
  margin-bottom:14px;
}

.hero h1 {
  font-size:clamp(30px,5vw,52px);
  font-weight:800;
  line-height:1.15;
}

.hero h1 em {
  font-style:normal;
  color:var(--amber);
}

.hero p {
  margin:16px 0 26px;
  color:#CFE2D8;
  max-width:480px;
}

.cta {
  display:flex;
  gap:12px;
  flex-wrap:wrap;
}

.art {
  align-self:end;
  position:relative;
  border-radius:20px 20px 0 0;
  overflow:hidden;
  box-shadow:0 -10px 40px rgba(0,0,0,.25);
}

.art svg {
  display:block;
  width:100%;
  height:auto;
}

.art img {
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
}

.btn {
  background:var(--green);
  color:#fff;
  border:0;
  border-radius:10px;
  padding:10px 18px;
  font-weight:700;
  transition:.15s;
}

.btn:hover {
  background:#0F2E22;
  transform:translateY(-1px);
}

.btn.amber {
  background:var(--amber);
  color:var(--ink);
}

.btn.amber:hover {
  background:#F2B455;
}

.btn.ghost {
  background:none;
  color:var(--ink);
  border:1px solid var(--line);
}

.btn.ghost:hover {
  background:#F0F2EE;
}

.btn.ghost.light {
  border-color:#6F9684;
  color:#fff;
}

.btn.ghost.light:hover {
  background:rgba(255,255,255,.1);
}

.btn.full {
  width:100%;
  padding:13px;
}

.btn:disabled {
  opacity:.5;
  cursor:not-allowed;
  transform:none;
}

.perks {
  background:var(--card);
  border-bottom:1px solid var(--line);
}

.perks .wrap {
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:16px;
  padding-top:18px;
  padding-bottom:18px;
  font-size:14px;
}

.perks b {
  display:block;
}

.perks span {
  color:var(--mute);
}

h2.t {
  font-size:30px;
  font-weight:800;
  margin:56px 0 6px;
}

.sub {
  color:var(--mute);
  margin-bottom:22px;
  max-width:560px;
}

.tabs {
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  margin-bottom:22px;
}

.tab {
  border:1px solid var(--line);
  background:var(--card);
  border-radius:999px;
  padding:6px 18px;
  font-weight:500;
}

.tab[aria-pressed=true] {
  background:var(--ink);
  color:#fff;
  border-color:var(--ink);
}

.grid {
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(250px,1fr));
  gap:22px;
}

.p {
  background:var(--card);
  border:1px solid var(--line);
  border-radius:18px;
  overflow:hidden;
  display:flex;
  flex-direction:column;
  transition:.2s;
}

.p:hover {
  transform:translateY(-4px);
  box-shadow:var(--sh);
}

.img {
  position:relative;
  overflow:hidden;
  background:#EEF1EC;
}

.p .img {
  height:210px;
}

.img svg,.img img {
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
}

.img img {
  object-fit:cover;
  transition:transform .4s;
}

.p:hover .img img {
  transform:scale(1.05);
}

.badge {
  position:absolute;
  top:12px;
  left:12px;
  background:var(--amber);
  color:var(--ink);
  font-size:12px;
  font-weight:700;
  border-radius:999px;
  padding:2px 12px;
  z-index:2;
}

.p .b {
  padding:16px;
  display:flex;
  flex-direction:column;
  gap:2px;
  flex:1;
}

.p h3 {
  font-size:16px;
}

.p small {
  color:var(--mute);
}

.p .row {
  margin-top:auto;
  padding-top:14px;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.price {
  font-weight:800;
  color:var(--green2);
  font-size:17px;
}

.about {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:36px;
  align-items:center;
}

.about .pic {
  border-radius:20px;
  overflow:hidden;
  position:relative;
  aspect-ratio:4/3;
  box-shadow:var(--sh);
}

.about .pic svg,.about .pic img {
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
}

.about .pic img {
  object-fit:cover;
}

.about p {
  margin-bottom:12px;
  color:#33463F;
}

.stats {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:12px;
  margin-top:16px;
}

.stats div {
  background:var(--card);
  border:1px solid var(--line);
  border-radius:14px;
  padding:14px;
}

.stats b {
  display:block;
  font-size:24px;
  color:var(--green2);
}

.stats span {
  font-size:13px;
  color:var(--mute);
}

.team {
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
  gap:16px;
}

.member {
  background:var(--card);
  border:1px solid var(--line);
  border-radius:16px;
  padding:18px;
  display:flex;
  gap:14px;
  align-items:center;
}

.av {
  width:60px;
  height:60px;
  border-radius:50%;
  overflow:hidden;
  position:relative;
  background:var(--green);
  color:#fff;
  display:grid;
  place-items:center;
  font-weight:800;
  font-size:20px;
  flex:none;
}

.av img {
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
}

.member small {
  color:var(--mute);
  display:block;
}

.contact {
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
  gap:16px;
  margin-bottom:64px;
}

.contact div {
  background:var(--card);
  border:1px solid var(--line);
  border-radius:16px;
  padding:18px;
}

.contact b {
  display:block;
  margin-bottom:4px;
}

.contact span {
  color:#33463F;
  font-size:15px;
}

footer {
  background:#0D2A1F;
  color:#BFD6CB;
  font-size:14px;
  padding:28px 0;
}

footer .wrap {
  display:flex;
  justify-content:space-between;
  gap:16px;
  flex-wrap:wrap;
}

.ov {
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.45);
  display:none;
  z-index:30;
}

.ov.on {
  display:block;
}

.drawer {
  position:fixed;
  top:0;
  right:0;
  bottom:0;
  width:min(420px,100%);
  background:var(--card);
  z-index:40;
  padding:20px;
  display:flex;
  flex-direction:column;
  transform:translateX(100%);
  transition:transform .25s;
}

.drawer.on {
  transform:none;
}

.drawer h2 {
  display:flex;
  justify-content:space-between;
  margin-bottom:12px;
  font-size:20px;
}

.items {
  flex:1;
  overflow:auto;
}

.it {
  display:grid;
  grid-template-columns:56px 1fr auto;
  gap:12px;
  align-items:center;
  padding:10px 0;
  border-bottom:1px solid var(--line);
}

.thumb {
  width:56px;
  height:56px;
  border-radius:10px;
  overflow:hidden;
  position:relative;
}

.thumb svg,.thumb img {
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
}

.thumb img {
  object-fit:cover;
}

.qty {
  display:inline-flex;
  align-items:center;
  border:1px solid var(--line);
  border-radius:8px;
  margin-top:4px;
}

.qty button {
  border:0;
  background:none;
  width:28px;
  height:28px;
}

.qty span {
  min-width:24px;
  text-align:center;
}

.x {
  background:none;
  border:0;
  color:var(--mute);
  font-size:13px;
}

.empty {
  color:var(--mute);
  padding:30px 0;
  text-align:center;
}

.sum {
  border-top:1px solid var(--line);
  padding-top:12px;
  margin-top:8px;
}

.sum div {
  display:flex;
  justify-content:space-between;
  padding:3px 0;
}

.sum .tot {
  font-weight:800;
  font-size:18px;
}

.co {
  display:grid;
  grid-template-columns:1.4fr 1fr;
  gap:24px;
  padding:32px 0 56px;
}

.box {
  background:var(--card);
  border:1px solid var(--line);
  border-radius:18px;
  padding:22px;
}

.box h2 {
  font-size:18px;
  margin-bottom:14px;
}

.f {
  display:grid;
  gap:4px;
  margin-bottom:12px;
}

.f label {
  font-size:14px;
  font-weight:500;
}

.f input,.f select {
  border:1px solid var(--line);
  border-radius:10px;
  padding:11px;
  background:#fff;
  width:100%;
}

.f input:focus,.f select:focus {
  border-color:var(--green2);
  outline:none;
  box-shadow:0 0 0 3px rgba(36,92,69,.15);
}

.f.bad input,.f.bad select {
  border-color:var(--err);
}

.f .m {
  font-size:12px;
  color:var(--err);
  display:none;
}

.f.bad .m {
  display:block;
}

.two {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}

.pay {
  display:grid;
  gap:8px;
}

.pay label {
  display:flex;
  gap:10px;
  align-items:center;
  border:1px solid var(--line);
  border-radius:12px;
  padding:12px;
  cursor:pointer;
}

.pay label:has(input:checked) {
  border-color:var(--green2);
  background:#E8F1EC;
}

.pinfo {
  margin-top:12px;
  font-size:14px;
  background:var(--bg);
  border-radius:12px;
  padding:14px;
}

.qr {
  display:grid;
  grid-template-columns:190px 1fr;
  gap:16px;
  align-items:center;
}

.qr .qrbox {
  background:#fff;
  border:1px solid var(--line);
  border-radius:12px;
  padding:8px;
  min-height:190px;
  display:grid;
  place-items:center;
  text-align:center;
  font-size:12px;
  color:var(--mute);
}

.qr img {
  width:100%;
  display:block;
}

.cpn {
  display:flex;
  gap:8px;
  margin:12px 0;
}

.cpn input {
  flex:1;
  border:1px solid var(--line);
  border-radius:10px;
  padding:9px;
}

#msg {
  font-size:13px;
  min-height:18px;
}

.ok {
  text-align:center;
  padding:70px 0;
}

.ok .tick {
  width:76px;
  height:76px;
  border-radius:50%;
  background:var(--green2);
  color:#fff;
  font-size:38px;
  display:grid;
  place-items:center;
  margin:0 auto 16px;
}

.hidden {
  display:none!important;
}

@media(max-width:820px) {
  .hero .wrap,.about,.co {
    grid-template-columns:1fr;
  }
  .perks .wrap {
    grid-template-columns:1fr 1fr;
  }
  .two,.qr {
    grid-template-columns:1fr;
  }
  .qr .qrbox {
    max-width:230px;
    margin:0 auto;
  }
  nav {
    display:none;
  }
  .topbar .wrap {
    justify-content:center;
  }
}

@media(prefers-reduced-motion:reduce) {
  * {
    transition:none!important;
  }
  html {
    scroll-behavior:auto;
  }
}


/* ===== Tinh chỉnh giao diện ===== */
::selection { background: var(--amber); color: var(--ink); }
header { box-shadow: 0 2px 12px rgba(0, 0, 0, .15); }
h2.t::after { content: ""; display: block; width: 48px; height: 4px; border-radius: 4px; background: var(--amber); margin-top: 8px; }
.perks .wrap > div { padding-left: 14px; border-left: 3px solid var(--amber); }
.box { box-shadow: var(--sh); }
.p .img::after { content: ""; position: absolute; inset: auto 0 0 0; height: 40%; background: linear-gradient(transparent, rgba(0, 0, 0, .08)); pointer-events: none; }
.stats div, .member, .contact div { transition: .2s; }
.stats div:hover, .member:hover, .contact div:hover { transform: translateY(-3px); box-shadow: var(--sh); }
footer { border-top: 4px solid var(--amber); }